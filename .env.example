# Core
NODE_ENV=development
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-strong-random-jwt-secret

# Session hardening
ENABLE_SESSION_REGISTRY=true
SESSION_TTL_DAYS=7
SESSION_REMEMBER_TTL_DAYS=3650
SESSION_ABSOLUTE_MAX_DAYS=90
SESSION_REMEMBER_ABSOLUTE_MAX_DAYS=36500
SESSION_REFRESH_WINDOW_HOURS=72
SESSION_INACTIVITY_TIMEOUT_DAYS=45
SESSION_SENSITIVE_ACTION_MAX_AGE_HOURS=24

# Data encryption (2FA secrets)
# Use keyed config in production.
DATA_ENCRYPTION_KEYS=default=replace-with-32-byte-base64-or-64-char-hex
DATA_ENCRYPTION_KEY_ID=default
DATA_ENCRYPTION_STRICT_PRODUCTION=true

# Project note file signing
PROJECT_NOTES_SIGNING_SECRET=replace-with-strong-random-signing-secret
PROJECT_NOTES_SIGNED_URL_TTL_SECONDS=2592000

# Optional debug API (non-production only)
DEBUG_API_ENABLED=false
DEBUG_API_SECRET=replace-with-strong-random-debug-secret

# Cron protection
CRON_SECRET=replace-with-strong-random-cron-secret
