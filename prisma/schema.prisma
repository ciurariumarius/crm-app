// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users            User[]
  partners         Partner[]
  sites            Site[]
  services         Service[]
  projects         Project[]
  tasks            Task[]
  timeLogs         TimeLog[]
  auditLogs        AuditLog[]
  projectRollovers ProjectRollover[]
  authSessions     AuthSession[]
  lmsTaskLogs      LmsTaskLog[]
  lmsAllocations   LmsAllocation[]
  lmsWorkTasks     LmsWorkTask[]
  lmsWorkEntries   LmsWorkEntry[]
  notes            Note[]
  noteFolders      NoteFolder[]

  @@map("tenants")
}

model Partner {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  businessName   String?  @map("business_name")
  isMainJob      Boolean  @default(false) @map("is_main_job")
  emailPrimary   String?  @map("email_primary")
  emailSecondary String?  @map("email_secondary")
  phone          String?
  internalNotes  String?  @map("internal_notes")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sites  Site[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("partners")
}

model Site {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  partnerId   String  @map("partner_id")
  name        String? // Optional custom name override
  domainName  String  @map("domain_name")
  faviconUrl  String? @map("favicon_url")
  gtmId       String? @map("gtm_id")
  googleAdsId String? @map("google_ads_id")
  driveLink   String? @map("drive_link")

  // Marketing Vault stored as JSON
  // Structure: { headlines: string[], brandNotes: string, competitors: string[] }
  marketingVault String? @map("marketing_vault")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  projects Project[]

  @@unique([tenantId, id])
  @@unique([tenantId, domainName])
  @@index([tenantId])
  @@index([partnerId])
  @@index([tenantId, partnerId])
  @@map("sites")
}

model Service {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  serviceName String  @map("service_name")
  isRecurring Boolean @default(false) @map("is_recurring") // Recurring (PPC) vs One-time (GTM)

  // Stored as JSON string due to SQLite limitation on scalar arrays
  standardTasks String   @map("standard_tasks") // JSON array of strings
  sopLink       String?  @map("sop_link")
  baseFee       Decimal? @map("base_fee")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([tenantId, serviceName])
  @@index([tenantId])
  @@index([tenantId, isRecurring])
  @@map("service_library")
}

model Project {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  siteId      String  @map("site_id")
  name        String? // Optional custom name override
  description String? // Optional rich text content

  status              String    @default("Active") // Active, Paused, Completed, Closed
  paymentStatus       String    @default("Unpaid") @map("payment_status") // Paid, Unpaid
  paidAt              DateTime? @map("paid_at")
  currentFee          Decimal?  @map("current_fee")
  closedAt            DateTime? @map("closed_at")
  closedMonthKey      String?   @map("closed_month_key")
  isHeavyRevenueMonth Boolean   @default(false) @map("is_heavy_revenue_month")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site              Site              @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Cascade)
  services          Service[]
  tasks             Task[]
  timeLogs          TimeLog[]
  rolloversAsSource ProjectRollover[] @relation("ProjectRolloverSource")
  rolloversAsTarget ProjectRollover[] @relation("ProjectRolloverTarget")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([siteId])
  @@index([tenantId, siteId])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, paymentStatus, createdAt])
  @@index([tenantId, currentFee])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, paymentStatus, updatedAt])
  @@index([tenantId, closedMonthKey])
  @@index([tenantId, isHeavyRevenueMonth, closedMonthKey])
  @@index([tenantId, status, closedAt])
  @@map("projects")
}

model Task {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  projectId        String?   @map("project_id")
  name             String
  description      String?
  status           String    @default("Active") // Active, Completed
  urgency          String    @default("Normal") // Normal, Idea, Urgent
  deadline         DateTime?
  estimatedMinutes Int?      @map("estimated_minutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  timeLogs TimeLog[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, projectId])
  @@index([tenantId, projectId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, name])
  @@index([tenantId, status, deadline])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, urgency, deadline])
  @@map("tasks")
}

model TimeLog {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  userId    String  @map("user_id")
  projectId String  @map("project_id")
  taskId    String? @map("task_id") // Optional: can log to project generally

  description     String?
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  durationSeconds Int?      @map("duration_seconds")
  isPaused        Boolean   @default(false) @map("is_paused")
  source          String    @default("MANUAL") // MANUAL, TIMER

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([projectId])
  @@index([tenantId, projectId])
  @@index([tenantId, userId, endTime])
  @@index([tenantId, userId, isPaused, endTime])
  @@index([taskId])
  @@index([tenantId, endTime])
  @@index([tenantId, startTime])
  @@index([tenantId, isPaused, endTime])
  @@map("time_logs")
}

model User {
  id                           String   @id @default(uuid())
  tenantId                     String   @map("tenant_id")
  username                     String   @unique
  name                         String?
  profilePic                   String?  @map("profile_pic")
  passwordHash                 String   @map("password_hash")
  hourlyRate                   Decimal? @default(0) @map("hourly_rate")
  timerIdlePauseMinutes        Int?     @default(60) @map("timer_idle_pause_minutes")
  timerHardCapHours            Int?     @default(3) @map("timer_hard_cap_hours")
  timerReminderIntervalMinutes Int?     @default(60) @map("timer_reminder_interval_minutes")
  twoFactorSecret              String?  @map("two_factor_secret")
  twoFactorEnabled             Boolean  @default(false) @map("two_factor_enabled")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authSessions   AuthSession[]
  timeLogs       TimeLog[]
  lmsWorkEntries LmsWorkEntry[]
  notes          Note[]
  noteFolders    NoteFolder[]

  @@index([tenantId])
  @@map("users")
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limit_entries")
}

model AuthSession {
  id                  String    @id
  tenantId            String    @map("tenant_id")
  userId              String    @map("user_id")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  rememberDevice      Boolean   @default(false) @map("remember_device")
  expiresAt           DateTime  @map("expires_at")
  maxSessionExpiresAt DateTime  @map("max_session_expires_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([tenantId, expiresAt])
  @@index([tenantId, maxSessionExpiresAt])
  @@index([userId])
  @@map("auth_sessions")
}

model Note {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  folderId    String?  @map("folder_id")
  title       String   @default("Untitled")
  content     String   @default("")
  contentText String   @default("") @map("content_text")
  archived    Boolean  @default(false)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, folderId, updatedAt])
  @@index([tenantId, archived, updatedAt])
  @@index([tenantId, pinned, updatedAt])
  @@map("notes")
}

model NoteFolder {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  Note[]

  @@unique([tenantId, name])
  @@index([tenantId, userId])
  @@index([tenantId, isDefault])
  @@index([tenantId, createdAt])
  @@map("note_folders")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  success     Boolean  @default(true)
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProjectRollover {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  sourceProjectId String   @map("source_project_id")
  newProjectId    String?  @map("new_project_id")
  targetYear      Int      @map("target_year")
  targetMonth     Int      @map("target_month")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceProject Project  @relation("ProjectRolloverSource", fields: [tenantId, sourceProjectId], references: [tenantId, id], onDelete: Cascade)
  newProject    Project? @relation("ProjectRolloverTarget", fields: [newProjectId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceProjectId, targetYear, targetMonth])
  @@index([tenantId, targetYear, targetMonth])
  @@map("project_rollovers")
}

model LmsTaskLog {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  syncKey         String    @map("sync_key")
  sourceId        String?   @map("source_id")
  taskDate        DateTime? @map("task_date")
  client          String
  taskName        String    @map("task_name")
  executant       String
  durationMinutes Int       @map("duration_minutes")
  status          String    @default("-")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, syncKey])
  @@index([tenantId, taskDate])
  @@index([tenantId, executant])
  @@index([tenantId, client])
  @@map("lms_task_logs")
}

model LmsAllocation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  syncKey    String   @map("sync_key")
  client     String
  specialist String   @default("Unassigned")
  seo        String   @default("-")
  gads       String   @default("-")
  fads       String   @default("-")
  tads       String   @default("-")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workEntries LmsWorkEntry[]

  @@unique([tenantId, syncKey])
  @@index([tenantId, client])
  @@index([tenantId, specialist])
  @@map("lms_allocations")
}

model LmsWorkTask {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  normalizedName String   @map("normalized_name")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries LmsWorkEntry[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive, name])
  @@map("lms_work_tasks")
}

model LmsWorkEntry {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  userId               String   @map("user_id")
  lmsAllocationId      String?  @map("lms_allocation_id")
  taskTypeId           String   @map("task_type_id")
  workDate             String   @map("work_date")
  durationMinutes      Int      @map("duration_minutes")
  clientDomainSnapshot String   @map("client_domain_snapshot")
  taskNameSnapshot     String   @map("task_name_snapshot")
  employeeNameSnapshot String   @map("employee_name_snapshot")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lmsAllocation LmsAllocation? @relation(fields: [lmsAllocationId], references: [id], onDelete: SetNull)
  taskType      LmsWorkTask    @relation(fields: [taskTypeId], references: [id], onDelete: NoAction)

  @@index([tenantId, userId, workDate])
  @@index([tenantId, lmsAllocationId])
  @@index([tenantId, taskTypeId])
  @@map("lms_work_entries")
}
