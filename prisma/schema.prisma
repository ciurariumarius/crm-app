// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Partner {
  id             String   @id @default(uuid())
  name           String
  businessName   String?  @map("business_name")
  isMainJob      Boolean  @default(false) @map("is_main_job")
  emailPrimary   String?  @map("email_primary")
  emailSecondary String?  @map("email_secondary")
  phone          String?
  internalNotes  String?  @map("internal_notes")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  sites Site[]

  @@unique([name])
  @@map("partners")
}

model Site {
  id          String  @id @default(uuid())
  partnerId   String  @map("partner_id")
  name        String? // Optional custom name override
  domainName  String  @map("domain_name")
  faviconUrl  String? @map("favicon_url")
  gtmId       String? @map("gtm_id")
  googleAdsId String? @map("google_ads_id")
  driveLink   String? @map("drive_link")

  // Marketing Vault stored as JSON
  // Structure: { headlines: string[], brandNotes: string, competitors: string[] }
  marketingVault String? @map("marketing_vault")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([domainName])
  @@index([partnerId])
  @@map("sites")
}

model Service {
  id          String  @id @default(uuid())
  serviceName String  @map("service_name")
  isRecurring Boolean @default(false) @map("is_recurring") // Recurring (PPC) vs One-time (GTM)

  // Stored as JSON string due to SQLite limitation on scalar arrays
  standardTasks String   @map("standard_tasks") // JSON array of strings
  sopLink       String?  @map("sop_link")
  baseFee       Decimal? @map("base_fee")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projects Project[]

  @@unique([serviceName])
  @@index([isRecurring])
  @@map("service_library")
}

model Project {
  id          String  @id @default(uuid())
  siteId      String  @map("site_id")
  name        String? // Optional custom name override
  description String? // Optional rich text content

  status              String    @default("Active") // Active, Paused, Completed, Closed
  paymentStatus       String    @default("Unpaid") @map("payment_status") // Paid, Unpaid
  paidAt              DateTime? @map("paid_at")
  paymentMethod       String?   @map("payment_method")
  currentFee          Decimal?  @map("current_fee")
  recurringBaseFee    Decimal?  @map("recurring_base_fee")
  closedAt            DateTime? @map("closed_at")
  closedMonthKey      String?   @map("closed_month_key")
  isHeavyRevenueMonth Boolean   @default(false) @map("is_heavy_revenue_month")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  site              Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  services          Service[]
  tasks             Task[]
  timeLogs          TimeLog[]
  noteDrawings      NoteDrawing[]
  rolloversAsSource ProjectRollover[] @relation("ProjectRolloverSource")
  rolloversAsTarget ProjectRollover[] @relation("ProjectRolloverTarget")

  @@index([siteId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([currentFee])
  @@index([status, updatedAt])
  @@index([paymentStatus, updatedAt])
  @@index([paymentMethod])
  @@index([closedMonthKey])
  @@index([isHeavyRevenueMonth, closedMonthKey])
  @@index([status, closedAt])
  @@map("projects")
}

model Task {
  id               String    @id @default(uuid())
  projectId        String?   @map("project_id")
  taskScope        String    @default("GENERAL") @map("task_scope") // GENERAL, FREELANCE, LMS
  lmsAllocationId  String?   @map("lms_allocation_id")
  lmsTaskTypeId    String?   @map("lms_task_type_id")
  name             String
  description      String?
  status           String    @default("Active") // Active, Completed
  urgency          String    @default("Normal") // Normal, Idea, Urgent
  deadline         DateTime?
  estimatedMinutes Int?      @map("estimated_minutes")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lmsAllocation LmsAllocation? @relation(fields: [lmsAllocationId], references: [id], onDelete: SetNull)
  lmsTaskType   LmsWorkTask?   @relation(fields: [lmsTaskTypeId], references: [id], onDelete: SetNull)
  lmsWorkEntry  LmsWorkEntry?
  timeLogs      TimeLog[]
  noteDrawings  NoteDrawing[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([taskScope, status])
  @@index([lmsAllocationId])
  @@index([lmsTaskTypeId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([name])
  @@index([status, deadline])
  @@index([status, createdAt])
  @@index([urgency, deadline])
  @@map("tasks")
}

model NoteDrawing {
  id           String   @id @default(uuid())
  noteId       String?  @map("note_id")
  projectId    String?  @map("project_id")
  taskId       String?  @map("task_id")
  strokeData   String   @map("stroke_data")
  previewPath  String   @map("preview_path")
  canvasWidth  Int      @map("canvas_width")
  canvasHeight Int      @map("canvas_height")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([projectId])
  @@index([taskId])
  @@index([updatedAt])
  @@map("note_drawings")
}

model TimeLog {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  taskId    String? @map("task_id") // Optional: can log to project generally

  description     String?
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  durationSeconds Int?      @map("duration_seconds")
  isPaused        Boolean   @default(false) @map("is_paused")
  source          String    @default("MANUAL") // MANUAL, TIMER

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([endTime])
  @@index([startTime])
  @@index([isPaused, endTime])
  @@map("time_logs")
}

model User {
  id                           String   @id @default(uuid())
  username                     String   @unique
  name                         String?
  profilePic                   String?  @map("profile_pic")
  passwordHash                 String   @map("password_hash")
  hourlyRate                   Decimal? @default(0) @map("hourly_rate")
  timerIdlePauseMinutes        Int?     @default(60) @map("timer_idle_pause_minutes")
  timerHardCapHours            Int?     @default(3) @map("timer_hard_cap_hours")
  timerReminderIntervalMinutes Int?     @default(60) @map("timer_reminder_interval_minutes")
  twoFactorSecret              String?  @map("two_factor_secret")
  twoFactorEnabled             Boolean  @default(false) @map("two_factor_enabled")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt

  authSessions AuthSession[]

  @@map("users")
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limit_entries")
}

model AuthSession {
  id                  String    @id
  userId              String    @map("user_id")
  userAgent           String?   @map("user_agent")
  ipAddress           String?   @map("ip_address")
  rememberDevice      Boolean   @default(false) @map("remember_device")
  expiresAt           DateTime  @map("expires_at")
  maxSessionExpiresAt DateTime  @map("max_session_expires_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([maxSessionExpiresAt])
  @@index([userId])
  @@map("auth_sessions")
}

model Note {
  id            String    @id @default(uuid())
  folderId      String?   @map("folder_id")
  title         String    @default("Untitled")
  content       String    @default("")
  contentText   String    @default("") @map("content_text")
  archived      Boolean   @default(false)
  pinned        Boolean   @default(false)
  deletedAt     DateTime? @map("deleted_at")
  hasChecklist  Boolean   @default(false) @map("has_checklist")
  hasAttachment Boolean   @default(false) @map("has_attachment")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  folder   NoteFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags     NoteTagAssignment[]
  drawings NoteDrawing[]

  @@index([folderId, updatedAt])
  @@index([archived, updatedAt])
  @@index([pinned, updatedAt])
  @@index([deletedAt, updatedAt])
  @@map("notes")
}

model NoteFolder {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(1000) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  notes    Note[]
  parent   NoteFolder?  @relation("NoteFolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NoteFolder[] @relation("NoteFolderHierarchy")

  @@unique([name])
  @@index([isDefault])
  @@index([parentId, sortOrder])
  @@index([createdAt])
  @@map("note_folders")
}

model NoteTag {
  id             String               @id @default(uuid())
  name           String
  normalizedName String               @unique @map("normalized_name")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")
  notes          NoteTagAssignment[]
  smartFolders   NoteSmartFolderTag[]

  @@index([name])
  @@map("note_tags")
}

model NoteTagAssignment {
  noteId    String   @map("note_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag       NoteTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId, noteId])
  @@map("note_tag_assignments")
}

model NoteSmartFolder {
  id                String               @id @default(uuid())
  name              String               @unique
  matchMode         String               @default("all") @map("match_mode")
  requirePinned     Boolean?             @map("require_pinned")
  requireChecklist  Boolean?             @map("require_checklist")
  requireAttachment Boolean?             @map("require_attachment")
  updatedWithinDays Int?                 @map("updated_within_days")
  sortOrder         Int                  @default(1000) @map("sort_order")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")
  tags              NoteSmartFolderTag[]

  @@index([sortOrder])
  @@map("note_smart_folders")
}

model NoteSmartFolderTag {
  smartFolderId String          @map("smart_folder_id")
  tagId         String          @map("tag_id")
  smartFolder   NoteSmartFolder @relation(fields: [smartFolderId], references: [id], onDelete: Cascade)
  tag           NoteTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([smartFolderId, tagId])
  @@index([tagId, smartFolderId])
  @@map("note_smart_folder_tags")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  success     Boolean  @default(true)
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProjectRollover {
  id              String   @id @default(uuid())
  sourceProjectId String   @map("source_project_id")
  newProjectId    String?  @map("new_project_id")
  targetYear      Int      @map("target_year")
  targetMonth     Int      @map("target_month")
  createdAt       DateTime @default(now()) @map("created_at")

  sourceProject Project  @relation("ProjectRolloverSource", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  newProject    Project? @relation("ProjectRolloverTarget", fields: [newProjectId], references: [id], onDelete: SetNull)

  @@unique([sourceProjectId, targetYear, targetMonth])
  @@index([targetYear, targetMonth])
  @@map("project_rollovers")
}

model LmsTaskLog {
  id              String    @id @default(uuid())
  syncKey         String    @map("sync_key")
  sourceId        String?   @map("source_id")
  taskDate        DateTime? @map("task_date")
  client          String
  taskName        String    @map("task_name")
  executant       String
  durationMinutes Int       @map("duration_minutes")
  status          String    @default("-")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([syncKey])
  @@index([taskDate])
  @@index([executant])
  @@index([client])
  @@map("lms_task_logs")
}

model LmsAllocation {
  id         String   @id @default(uuid())
  syncKey    String   @map("sync_key")
  client     String
  specialist String   @default("Unassigned")
  seo        String   @default("-")
  gads       String   @default("-")
  fads       String   @default("-")
  tads       String   @default("-")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  workEntries     LmsWorkEntry[]
  workRecurrences LmsWorkRecurrence[]
  tasks           Task[]

  @@unique([syncKey])
  @@index([client])
  @@index([specialist])
  @@map("lms_allocations")
}

model LmsWorkTask {
  id                     String   @id @default(uuid())
  name                   String
  normalizedName         String   @map("normalized_name")
  isActive               Boolean  @default(true) @map("is_active")
  sortOrder              Int      @default(1000) @map("sort_order")
  defaultDurationMinutes Int?     @map("default_duration_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  entries     LmsWorkEntry[]
  recurrences LmsWorkRecurrence[]
  tasks       Task[]

  @@unique([normalizedName])
  @@index([isActive, name])
  @@index([sortOrder])
  @@map("lms_work_tasks")
}

model LmsWorkEntry {
  id                   String    @id @default(uuid())
  lmsAllocationId      String?   @map("lms_allocation_id")
  taskTypeId           String?   @map("task_type_id")
  crmTaskId            String?   @unique @map("crm_task_id")
  workDate             String    @map("work_date")
  durationMinutes      Int       @map("duration_minutes")
  clientDomainSnapshot String    @map("client_domain_snapshot")
  taskNameSnapshot     String    @map("task_name_snapshot")
  crmTaskNameSnapshot  String?   @map("crm_task_name_snapshot")
  employeeNameSnapshot String    @map("employee_name_snapshot")
  origin               String    @default("MANUAL") // MANUAL, RECURRENCE, CRM_TASK
  sourceKey            String?   @map("source_key")
  exportedAt           DateTime? @map("exported_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  lmsAllocation LmsAllocation? @relation(fields: [lmsAllocationId], references: [id], onDelete: SetNull)
  taskType      LmsWorkTask?   @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  crmTask       Task?          @relation(fields: [crmTaskId], references: [id], onDelete: SetNull)

  @@unique([sourceKey, workDate])
  @@index([workDate])
  @@index([exportedAt, workDate])
  @@index([lmsAllocationId])
  @@index([taskTypeId])
  @@index([origin, workDate])
  @@map("lms_work_entries")
}

model LmsWorkRecurrence {
  id               String    @id @default(uuid())
  lmsAllocationId  String?   @map("lms_allocation_id")
  taskTypeId       String    @map("task_type_id")
  clientSnapshot   String    @map("client_snapshot")
  taskSnapshot     String    @map("task_snapshot")
  durationMinutes  Int       @map("duration_minutes")
  weekdayMask      Int       @map("weekday_mask")
  isActive         Boolean   @default(true) @map("is_active")
  startsOn         String?   @map("starts_on")
  processedThrough String?   @map("processed_through")
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  lmsAllocation LmsAllocation? @relation(fields: [lmsAllocationId], references: [id], onDelete: SetNull)
  taskType      LmsWorkTask    @relation(fields: [taskTypeId], references: [id], onDelete: NoAction)

  @@index([isActive])
  @@index([lmsAllocationId])
  @@index([taskTypeId])
  @@map("lms_work_recurrences")
}
