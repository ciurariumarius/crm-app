!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
audit_output*.txt
lint_output.txt
test-ssh.exp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

