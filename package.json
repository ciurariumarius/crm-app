    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.0",
    "papaparse": "^5.5.3",
    "perfect-freehand": "^1.2.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-use": "^17.6.1",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.33",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.3",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "brace-expansion": "^1.1.16",
    "dompurify": "^3.4.13",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "$sharp",
    "tmp": "^0.2.7"
  }
}
