{
  "name": "pixelist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks types proxy.ts next.config.ts prisma.config.ts",
    "lint:all": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean:artifacts": "rm -rf .next tmp/*.json tsconfig.tsbuildinfo",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:filters": "tsx scripts/verify-filter-helpers.ts",
    "verify:mobile": "tsx scripts/verify-mobile-guardrails.ts",
    "verify:tablet": "node --import tsx scripts/verify-tablet-guardrails.ts",
    "security:test-guardrails": "tsx scripts/verify-security-guardrails.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check-encryption-config": "tsx scripts/check-encryption-config.ts",
    "security:rotate-2fa-secrets": "tsx scripts/rotate-two-factor-secrets.ts",
    "security:rotate-2fa-secrets:dry": "tsx scripts/rotate-two-factor-secrets.ts --dry-run",
    "data:backfill-project-names": "node scripts/backfill-project-names.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.3",
    "otpauth": "^9.5.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-use": "^17.6.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "prisma": "^6.19.3",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "brace-expansion": "^1.1.13"
  }
}
