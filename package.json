{
  "name": "pixelist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:safe": "bash scripts/build-safe.sh",
    "start": "next start",
    "lint": "eslint app components lib hooks types proxy.ts next.config.ts prisma.config.ts",
    "lint:all": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean:artifacts": "rm -rf .next tmp/*.json tsconfig.tsbuildinfo",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:filters": "tsx scripts/verify-filter-helpers.ts",
    "test:lms-work": "tsx scripts/verify-lms-work-entries.ts",
    "test:lms-daily-admin": "tsx scripts/verify-lms-daily-admin-integration.ts",
    "test:task-lms-integration": "vitest run --config vitest.task-lms.config.ts",
    "test:payments-integration": "vitest run --config vitest.payments.config.ts",
    "test:note-drawings-integration": "vitest run --config vitest.note-drawings.config.ts",
    "test:data-queries": "tsx scripts/verify-data-query-optimizations.ts",
    "test:notes-drag-drop": "tsx scripts/verify-notes-drag-drop.ts",
    "verify:mobile": "tsx scripts/verify-mobile-guardrails.ts",
    "verify:tablet": "node --import tsx scripts/verify-tablet-guardrails.ts",
    "verify:design": "tsx scripts/verify-design-system.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "security:check-public-assets": "tsx scripts/check-public-assets.ts",
    "runtime:preflight": "tsx scripts/runtime-preflight.ts",
    "security:test-guardrails": "tsx scripts/verify-security-guardrails.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check-encryption-config": "tsx scripts/check-encryption-config.ts",
    "security:rotate-2fa-secrets": "tsx scripts/rotate-two-factor-secrets.ts",
    "security:rotate-2fa-secrets:dry": "tsx scripts/rotate-two-factor-secrets.ts --dry-run",
    "data:preflight-single-owner": "tsx scripts/preflight-single-owner.ts",
    "data:migrate-project-note-storage": "tsx scripts/migrate-project-note-storage.ts",
    "data:migrate-project-note-storage:dry": "tsx scripts/migrate-project-note-storage.ts --dry-run",
    "data:backfill-project-names": "node scripts/backfill-project-names.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
